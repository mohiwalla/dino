// The game and its leaderboard server as one Cloudflare Worker: /api/* runs worker/index.ts,
// everything else is the Vite build in dist/. Secrets: ENTRA_CLIENT_SECRET (wrangler secret put).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dino-3d",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dino-3d",
      "database_id": "25fe6517-c62c-4b8f-8c47-2f55f9965a4d",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "dino.mohiwalla.com", "custom_domain": true },
    { "pattern": "dino-next.mohiwalla.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    "ORIGINS": "https://dino.mohiwalla.com,https://dino-next.mohiwalla.com",
    // Single-tenant app registration "Dino 3D Leaderboard" in the Sifars tenant.
    "ENTRA_TENANT_ID": "9698f849-129c-4757-bbfa-9c804f1ac921",
    "ENTRA_CLIENT_ID": "c7fd95ce-08f0-4cb8-b9d5-8b6f60935f16",
    "ADMIN_EMAILS": "kamaljot.singh@sifars.com"
  }
}
